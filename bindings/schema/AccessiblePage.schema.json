{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "AccessibleNode": {
      "description": "Bounded semantic metadata for a keyboard/screen-reader companion to a GPU view.",
      "properties": {
        "id": {
          "format": "uuid",
          "type": "string"
        },
        "rect": {
          "$ref": "#/definitions/Rect"
        },
        "selected": {
          "type": "boolean"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "rect",
        "selected"
      ],
      "type": "object"
    },
    "Rect": {
      "properties": {
        "height": {
          "format": "float",
          "type": "number"
        },
        "width": {
          "format": "float",
          "type": "number"
        },
        "x": {
          "format": "float",
          "type": "number"
        },
        "y": {
          "format": "float",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "type": "object"
    }
  },
  "properties": {
    "next": {
      "format": "uuid",
      "type": [
        "string",
        "null"
      ]
    },
    "nodes": {
      "items": {
        "$ref": "#/definitions/AccessibleNode"
      },
      "type": "array"
    },
    "revision": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "total": {
      "format": "uint",
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "revision",
    "total",
    "nodes"
  ],
  "title": "AccessiblePage",
  "type": "object"
}
