{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "GroupSummary": {
      "properties": {
        "id": {
          "format": "uuid",
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "members": {
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "label",
        "members"
      ],
      "type": "object"
    }
  },
  "properties": {
    "groups": {
      "items": {
        "$ref": "#/definitions/GroupSummary"
      },
      "type": "array"
    },
    "next": {
      "format": "uuid",
      "type": [
        "string",
        "null"
      ]
    },
    "revision": {
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    },
    "selected_nodes": {
      "format": "uint",
      "minimum": 0.0,
      "type": "integer"
    },
    "total": {
      "format": "uint",
      "minimum": 0.0,
      "type": "integer"
    }
  },
  "required": [
    "groups",
    "revision",
    "selected_nodes",
    "total"
  ],
  "title": "GroupPage",
  "type": "object"
}
